# ============================================
# 数据库配置
# ============================================
POSTGRES_USER=binance
POSTGRES_DB=binance_data
DB_PASSWORD=你的强密码_至少 16 位

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=你的强密码_至少 16 位

# ============================================
# 飞书 Webhook 配置（5 个项目）
# ============================================
# BTC/ETH 交易系统
BTC_ETH_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/01d5e59c-7dfb-4f71-810b-141cec30aa43

# 新币做空系统
NEW_COIN_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/57b315d7-7759-4cb2-8783-47c46a418dbb

# 网格交易系统
GRID_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/18d816f0-7150-48f6-a521-b5c68c6248b7

# 检查自动化系统
INSPECTION_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/94ab2c34-52e3-4737-9e2f-c8cd8235e8e7

# 股票筛选系统
STOCK_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/955aced6-5b07-42a6-a714-4c5f4726b003

# ============================================
# K 线数据服务配置
# ============================================
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
COLLECT_INTERVALS=15m,1h,4h,1d

# ============================================
# 通知服务配置
# ============================================
WORKER_COUNT=3
RATE_LIMIT_PER_MINUTE=60

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
