# 数据库配置
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trading_platform
DATABASE_USER=trading_user
DATABASE_PASSWORD=your_password_here
TRADE_ACCOUNT_ID=default

# Binance API配置
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=false

# K线服务配置
KLINE_SERVICE_URL=http://43.156.242.184:8765/api/v1
KLINE_SERVICE_TIMEOUT=10

# 通知服务配置
NOTIFICATION_SERVICE_URL=http://43.156.242.184:8766/api/v1

# 飞书Webhook配置（按项目）
FEISHU_WEBHOOK_GRID=your_grid_webhook_url_here
FEISHU_WEBHOOK_BTC_ETH=your_btc_eth_webhook_url_here
FEISHU_WEBHOOK_NEW_COIN=your_new_coin_webhook_url_here
FEISHU_WEBHOOK=your_default_webhook_url_here

# K线服务健康监控配置
# 可选，不设置则使用 FEISHU_WEBHOOK（默认 webhook）
FEISHU_WEBHOOK_KLINE_MONITOR=your_kline_monitor_webhook_url_here

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# 策略配置
STRATEGY_NAME=btc_eth
STRATEGY_ENV=production

# 独立 ETHUSDT 子账号订单网格；默认关闭。testnet/live 必须填写独立凭据及全部硬限额。
GRID_EXECUTION_MODE=off
GRID_SYMBOL=ETHUSDT
GRID_SUBACCOUNT_API_KEY=
GRID_SUBACCOUNT_API_SECRET=
GRID_MAX_MARGIN_USDT=
GRID_MAX_NOTIONAL_USDT=
GRID_MAX_DAILY_LOSS_USDT=
GRID_MAX_DRAWDOWN_USDT=
GRID_MAX_OPEN_ORDERS=
GRID_EXPECTED_LEVERAGE=
GRID_EXECUTION_HANDOFF_DB=
