# 网格交易信号灯系统 V2.0 环境变量配置

# ==================== 数据库配置 ====================
# PostgreSQL 连接 URL（使用 common_service 的数据库）
DATABASE_URL=postgresql://binance:Bianace%402024@43.156.242.184:5432/binance_data

# ==================== 服务配置 ====================
# K 线数据服务地址（使用服务器地址）
KLINE_SERVICE_URL=http://43.156.242.184:8765

# 推送服务地址（使用服务器地址）
NOTIFICATION_SERVICE_URL=http://43.156.242.184:8766

# ==================== 币安 API 配置（可选，用于获取实时价格）====================
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

# ==================== 定时运行配置 ====================
# 每小时的指定分钟运行（0-59）
RUN_MINUTE=35

# 休息时间段（逗号分隔的小时列表，凌晨00:00-06:00休息）
REST_HOURS=0,1,2,3,4,5
