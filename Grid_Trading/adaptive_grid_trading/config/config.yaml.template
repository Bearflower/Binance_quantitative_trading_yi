# 自适应趋势网格策略系统 - 配置文件模板
# 最后更新：2026-03-19
# 说明：复制此文件为 config.yaml，并填入实际配置

# ==================== 交易所配置 ====================
exchange:
  api_key: "${BINANCE_API_KEY}"
  api_secret: "${BINANCE_API_SECRET}"
  testnet: true  # 测试网：true，生产环境：false
  symbol: "BTCUSDT"
  contract_type: "PERPETUAL"  # 永续合约

# ==================== 策略参数 ====================
strategy:
  # 技术指标参数
  indicators:
    adx_period: 14
    adx_trend_threshold: 25      # ADX 趋势确认阈值
    adx_weak_threshold: 20       # ADX 弱趋势阈值
    ema_fast: 20                 # 快线 EMA 周期
    ema_slow: 50                 # 慢线 EMA 周期
    atr_period: 14               # ATR 计算周期
    atr_smoothing: 14            # ATR 平滑周期（EMA of ATR）
  
  # 网格参数
  grid:
    base_grid_count: 30          # 基准网格数量
    min_grid_count: 20           # 最小网格数量
    max_grid_count: 50           # 最大网格数量
    base_atr_window: 90          # 基准 ATR 计算窗口（天）
  
  # 风险管理参数
  risk:
    hard_stop_loss: -0.08        # 硬止损：-8%
    trailing_profit_start: 0.15  # 移动止盈启动阈值：15%
    trailing_profit_retrace: 0.5 # 移动止盈回撤比例：50%
    emergency_break_layers: 3    # 紧急暂停：突破网格层数
    emergency_break_window: 300  # 紧急暂停窗口（秒）
    position_coefficient: 0.5    # 仓位系数

# ==================== 执行配置 ====================
execution:
  inspection_interval: 3600      # 巡检间隔（秒）
  atr_change_threshold: 0.2      # ATR 变化触发阈值：20%
  
  # 参数调整配置（新增）
  parameter_adjustment:
    enabled: true                # 启用自动参数调整
    min_interval: 14400          # 最小调整间隔（秒）：4 小时
    max_adjustments_per_day: 6   # 每日最大调整次数
  
  # 滑点保护
  slippage_protection:
    limit_order_timeout: 3       # 限价单超时（秒）
    optimal_price_timeout: 2     # 最优价超时（秒）
    market_order_fallback: true  # 市价单 fallback

# ==================== 监控配置 ====================
monitoring:
  # 日志配置
  logging:
    level: "INFO"
    file: "logs/adaptive_grid.log"
    max_size: 10485760           # 10MB
    backup_count: 5              # 备份文件数量
    format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  
  # 报警配置
  alert:
    enabled: false               # 测试网：false，生产环境：true
    alert_on_parameter_adjustment: true  # 参数调整时报警
    feishu_webhook: "${FEISHU_WEBHOOK}"
    dingding_webhook: "${DINGDING_WEBHOOK}"
    telegram_bot_token: "${TELEGRAM_BOT_TOKEN}"
    telegram_chat_id: "${TELEGRAM_CHAT_ID}"
  
  # 性能监控
  metrics:
    enabled: true
    report_interval: 3600        # 报告间隔（秒）
